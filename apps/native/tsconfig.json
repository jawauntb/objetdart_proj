{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["app.config.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "plugins/**/*.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["src/**/__tests__/**"]
}
